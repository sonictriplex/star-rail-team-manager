# Vorlage: nach deploy/deploy.local.env kopieren und ausfüllen. Die .local.env-Datei steht in .gitignore.
# Hostname mit gültigem TLS-Zertifikat (bei dogado z. B. webNNN.dogado.net statt der eigenen Domain)
FTP_HOST=
FTP_USER=
FTP_PASS=''
# Web-Root auf dem Server, relativ zur FTP-Wurzel, ohne Schrägstriche am Rand
FTP_DIR=
# Optional: wird nach dem Upload auf HTTP 200 geprüft
SITE_URL=https://star-rail.media-matrix.de
